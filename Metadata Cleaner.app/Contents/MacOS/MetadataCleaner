#!/usr/bin/env bash
# Opens "Metadata Cleaner.command" in Terminal, which runs the server and opens the browser.
# Running in Terminal gives run.sh your normal shell environment (PATH, brew, python).
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
CMD="$ROOT/Metadata Cleaner.command"

if [ ! -f "$CMD" ]; then
  osascript -e 'display alert "Metadata Cleaner" message "Keep Metadata Cleaner.app inside the metadata-cleaner folder (Metadata Cleaner.command was not found next to it)."' >/dev/null 2>&1
  exit 1
fi

# Executable bits are lost when unzipping; Terminal needs them to run a .command.
chmod +x "$CMD" "$ROOT/run.sh" 2>/dev/null
open -a Terminal "$CMD"
