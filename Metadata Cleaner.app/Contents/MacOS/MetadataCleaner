#!/usr/bin/env bash
# Double-click launcher: no Terminal window. Starts the local server in the background,
# opens the browser, and offers to stop the server if it is already running.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT="${PORT:-8000}"
URL="http://127.0.0.1:$PORT"
STATE="$HOME/Library/Application Support/MetadataCleaner"
LOG="$HOME/Library/Logs/MetadataCleaner.log"
mkdir -p "$STATE" "$(dirname "$LOG")"

alert() { osascript -e "display alert \"Metadata Cleaner\" message \"$1\"" >/dev/null 2>&1; }
running() { curl -fs --max-time 2 "$URL/tools" 2>/dev/null | grep -q exiftool; }

if running; then
  choice=$(osascript -e 'button returned of (display dialog "Metadata Cleaner is running." buttons {"Stop server", "Open"} default button "Open")' 2>/dev/null) || exit 0
  if [ "$choice" = "Stop server" ]; then
    [ -f "$STATE/pid" ] && kill "$(cat "$STATE/pid")" 2>/dev/null
    rm -f "$STATE/pid"
  else
    open "$URL"
  fi
  exit 0
fi

if [ ! -f "$ROOT/run.sh" ]; then
  alert "Keep Metadata Cleaner.app inside the metadata-cleaner folder (run.sh was not found next to it)."
  exit 1
fi
if ! command -v brew >/dev/null; then
  alert "Homebrew is required. Install it from https://brew.sh and open this app again."
  exit 1
fi

osascript -e 'display notification "Starting… the first run installs tools and can take a few minutes." with title "Metadata Cleaner"' >/dev/null 2>&1

cd "$ROOT"
NO_OPEN=1 nohup ./run.sh >>"$LOG" 2>&1 </dev/null &
echo $! > "$STATE/pid"

# First run may install tools, so wait up to 10 minutes.
for _ in $(seq 1 600); do
  running && { open "$URL"; exit 0; }
  kill -0 "$(cat "$STATE/pid")" 2>/dev/null || break
  sleep 1
done
alert "Could not start Metadata Cleaner. See the log: $LOG"
exit 1
